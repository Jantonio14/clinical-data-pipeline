# Copy this file to .env (which is gitignored) and adjust if you want.
# docker-compose.yml and scripts/load_raw.py both read these values.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=clinical
POSTGRES_PASSWORD=clinical
POSTGRES_DB=clinical

# Where Synthea wrote its CSVs (relative to the project root)
SYNTHEA_CSV_DIR=synthea/output/csv
